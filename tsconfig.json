{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "apps/**/*.ts",
    "packages/**/*.ts"
  ]
}
