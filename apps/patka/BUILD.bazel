load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("//tools:ptk_app.bzl", "ptk_app")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//apps/patka:__subpackages__"],
)

# What every tool package needs to implement PatkaTool.
ts_project(
    name = "tool",
    srcs = [
        "json.ts",
        "option.ts",
        "tools/patka-tool.ts",
        "tools/patka-tool-manual.ts",
        "tools/patka-tool-relative-path.ts",
        "try.ts",
    ],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    visibility = ["//apps/patka:__subpackages__"],
    deps = [
        "//:package_json",
        "//:node_modules/@types/node",
        "//:node_modules/rxjs",
    ],
)

ptk_app(
    name = "patka",
    data = ["text/default.json"],
    entry_point = "bootstrap.js",
    npm_deps = [
        "//:node_modules/@anthropic-ai/sdk",
        "//:node_modules/ajv",
        "//:node_modules/blessed",
        "//:node_modules/ollama",
        "//:node_modules/pino",
        "//:node_modules/reflect-metadata",
        "//:node_modules/rxjs",
        "//:node_modules/ts-pattern",
        "//:node_modules/tsyringe",
        "//:node_modules/zx",
    ],
    packages = [
        "//apps/patka/tools/apply-patch",
        "//apps/patka/tools/git-diff",
        "//apps/patka/tools/git-status",
        "//apps/patka/tools/grep-files",
        "//apps/patka/tools/list-files",
        "//apps/patka/tools/read-file",
        "//apps/patka/tools/report-incompetency",
        "//apps/patka/tools/write-file",
    ],
    srcs = glob(
        ["**/*.ts"],
        exclude = [
            "**/*.spec.ts",
            "json.ts",
            "option.ts",
            "tools/patka-tool.ts",
            "tools/patka-tool-manual.ts",
            "tools/patka-tool-relative-path.ts",
            "try.ts",
            "vitest.config.ts",
        ],
    ),
    test_srcs = glob(["**/*.ts"]),
    type_deps = [
        "//:node_modules/@types/blessed",
        "//:node_modules/@types/node",
    ],
    deps = [":tool"],
)
