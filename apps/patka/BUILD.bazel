load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@npm//:vitest/package_json.bzl", vitest_bin = "bin")
load("//tools:lint.bzl", "biome_lint")

ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
    visibility = ["//apps/patka:__subpackages__"],
)

# What every tool package needs to implement PatkaTool.
ts_project(
    name = "tool",
    srcs = [
        "json.ts",
        "option.ts",
        "tools/patka-tool.ts",
        "tools/patka-tool-manual.ts",
    ],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    visibility = ["//apps/patka:__subpackages__"],
    deps = [
        "//:package_json",
        "//:node_modules/rxjs",
    ],
)

ts_project(
    name = "lib",
    srcs = glob(
        ["**/*.ts"],
        exclude = [
            "**/*.spec.ts",
            "json.ts",
            "option.ts",
            "tools/patka-tool.ts",
            "tools/patka-tool-manual.ts",
            "vitest.config.ts",
        ],
    ),
    assets = ["prompt/instruction.md"],
    declaration = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    deps = [
        ":tool",
        "//apps/patka/tools/list-files",
        "//apps/patka/tools/read-file",
        "//apps/patka/tools/report-incompetency",
        "//apps/patka/tools/write-file",
        "//:package_json",
        "//:node_modules/@anthropic-ai/sdk",
        "//:node_modules/@types/blessed",
        "//:node_modules/@types/node",
        "//:node_modules/blessed",
        "//:node_modules/ollama",
        "//:node_modules/pino",
        "//:node_modules/reflect-metadata",
        "//:node_modules/tsyringe",
        "//:node_modules/rxjs",
        "//:node_modules/ts-pattern",
    ],
)

js_binary(
    name = "patka",
    data = [
        ":lib",
        "//:package_json",
        "//:node_modules/@anthropic-ai/sdk",
        "//:node_modules/blessed",
        "//:node_modules/ollama",
        "//:node_modules/pino",
        "//:node_modules/reflect-metadata",
        "//:node_modules/tsyringe",
        "//:node_modules/rxjs",
        "//:node_modules/ts-pattern",
    ],
    entry_point = "main.js",
    visibility = ["//visibility:public"],
)

vitest_bin.vitest_test(
    name = "patka_test",
    args = ["run"],
    chdir = package_name(),
    data = glob(["**/*.ts"]) + [
        "prompt/instruction.md",
        "tsconfig.json",
        "//apps/patka/tools/list-files:test_data",
        "//apps/patka/tools/read-file:test_data",
        "//apps/patka/tools/report-incompetency:test_data",
        "//apps/patka/tools/write-file:test_data",
        "//:package_json",
        "//:node_modules/@anthropic-ai/sdk",
        "//:node_modules/blessed",
        "//:node_modules/ollama",
        "//:node_modules/pino",
        "//:node_modules/reflect-metadata",
        "//:node_modules/tsyringe",
        "//:node_modules/rxjs",
        "//:node_modules/ts-pattern",
        "//:node_modules/vitest",
    ],
)

biome_lint()
